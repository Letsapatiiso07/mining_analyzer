# Keep the processed CSV/GeoJSON files (small, useful for others to run fast)
# but ignore large rasters and model outputs
*.tif
*.tiff
*.geotiff

# ── Trained models (can be large — regenerate with scripts) ───────────────────
models/*.pt
models/*.pth
models/*.pkl
models/*.h5
models/*.onnx

# Keep the scaler (tiny, needed for inference)
!models/production_scaler.pkl

